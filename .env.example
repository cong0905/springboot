# Local MySQL only. Copy to .env and replace both passwords.
DB_PASSWORD=replace-with-your-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay/return

# Activate smtp/google profiles only after configuring these values.
APP_PUBLIC_URL=http://localhost:8080
APP_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini: disabled until you set a real server-side key and an available model.
APP_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
APP_AI_USER_TURNS_PER_DAY=20
APP_AI_GLOBAL_REQUESTS_PER_DAY=200
APP_AI_USER_TURNS_PER_MINUTE=2
APP_AI_GLOBAL_REQUESTS_PER_MINUTE=10
